def count_params(model):
    return sum(p.numel() for p in model.parameters())

def show(name, model):
    params = count_params(model)
    print(f"{name}: {params:,} (~{params/1e6:.2f}M / {params/1e9:.2f}B)")

show("UNet", pipe.unet)
show("VAE", pipe.vae)
show("Text Encoder", pipe.text_encoder)